# Copy to .env and fill in values. Never commit .env.
# Every variable is optional; defaults are shown.

# Socrata app token for data.cityofnewyork.us. Optional, but recommended:
# requests without a token may be throttled (HTTP 429). Create one at
# https://data.cityofnewyork.us/profile/edit/developer_settings
# It is sent only to the Socrata host, never to GeoSearch.
SOCRATA_APP_TOKEN=

# Base URLs (override only for testing).
SOCRATA_BASE_URL=https://data.cityofnewyork.us
GEOSEARCH_BASE_URL=https://geosearch.planninglabs.nyc

# HTTP behaviour for calls to external data sources.
HTTP_CONNECT_TIMEOUT_SECONDS=5
HTTP_READ_TIMEOUT_SECONDS=20
# Total attempts per request, including the first (so 3 = up to 2 retries).
HTTP_MAX_ATTEMPTS=3
# Longest Retry-After we are willing to wait; longer waits fail fast instead.
HTTP_MAX_RETRY_AFTER_SECONDS=30

# Set to 1 to run tests that call the live NYC APIs.
RUN_LIVE_TESTS=0

# Phase 2 record retrieval. Rows per Socrata page, and the most rows we fetch for one
# lot from one source (above it the result is marked incomplete_pagination).
SOCRATA_PAGE_SIZE=1000
SOURCE_ROW_CAP=10000

# Secret key for the keyed digest of unredacted rows in public records. Keep it out of
# git. Unset: a random per-process key is used (digests not stable across runs).
EVIDENCE_DIGEST_KEY=

# PostgreSQL (Phase 2 Task 4). A secret: never commit a real value.
# Application/migration connection, e.g. postgresql://user:password@host:5432/dbname
DATABASE_URL=
# Retention job (scripts/run_retention.py): a separate login holding ONLY the
# evidence_retention role. A secret: never commit a real value.
RETENTION_DATABASE_URL=
# Tests only: a login that can CREATE DATABASE and CREATE ROLE. Each test session makes
# and drops its own databases. Unset: database tests are skipped.
TEST_DATABASE_ADMIN_URL=
# Set to 1 to make database tests mandatory (CI): skips become failures.
REQUIRE_DB_TESTS=0
